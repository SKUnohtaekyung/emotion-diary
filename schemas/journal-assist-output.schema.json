{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/schemas/journal-assist-output.schema.json",
  "title": "Journal assistant structured output",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "assistantMessage", "suggestedEmotionCodes", "draftPatch", "missingRequiredFields", "readyForUserReview", "safetySignal"],
  "$defs": {
    "reflectionSlot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["slot", "text"],
      "properties": {
        "slot": { "type": "integer", "minimum": 1, "maximum": 3 },
        "text": { "type": ["string", "null"], "pattern": "\\S", "maxLength": 2000 }
      }
    },
    "reflectionSlots": {
      "type": "array",
      "maxItems": 3,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/reflectionSlot" }
    }
  },
  "properties": {
    "schemaVersion": { "const": "journal-assist-output-v1" },
    "assistantMessage": { "type": "string", "pattern": "\\S", "minLength": 1, "maxLength": 1000 },
    "suggestedEmotionCodes": {
      "type": "array",
      "maxItems": 5,
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^(enjoyment|wish|sadness|anger|joy|love|hate)-[a-z0-9][a-z0-9-]{0,55}$" }
    },
    "draftPatch": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "eventText": { "type": ["string", "null"], "maxLength": 10000 },
        "reasonText": { "type": ["string", "null"], "maxLength": 10000 },
        "emotions": {
          "type": "array",
          "maxItems": 100,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["emotionCode", "intensity"],
            "properties": {
              "emotionCode": { "type": "string", "pattern": "^(enjoyment|wish|sadness|anger|joy|love|hate)-[a-z0-9][a-z0-9-]{0,55}$" },
              "intensity": { "type": ["integer", "null"], "minimum": 1, "maximum": 10 }
            }
          }
        },
        "praises": { "$ref": "#/$defs/reflectionSlots" },
        "gratitudes": { "$ref": "#/$defs/reflectionSlots" }
      }
    },
    "missingRequiredFields": {
      "type": "array",
      "uniqueItems": true,
      "items": { "enum": ["eventText", "emotions", "intensities", "reasonText"] }
    },
    "readyForUserReview": { "type": "boolean" },
    "safetySignal": {
      "description": "D-020: AI 대화 경로에서만 산출. possible_crisis이면 서버는 draftPatch/suggestedEmotionCodes를 무시하고 위기 흐름으로 전환한다. 위험도 점수·진단 label은 두지 않는다.",
      "enum": ["none", "possible_crisis"]
    }
  },
  "allOf": [
    {
      "if": { "properties": { "safetySignal": { "const": "possible_crisis" } }, "required": ["safetySignal"] },
      "then": {
        "properties": {
          "readyForUserReview": { "const": false },
          "suggestedEmotionCodes": { "maxItems": 0 }
        }
      }
    }
  ]
}
