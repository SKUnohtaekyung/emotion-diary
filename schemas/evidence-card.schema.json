{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/schemas/evidence-card.schema.json",
  "title": "Psychology Evidence Card",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "evidenceId", "version", "status", "title", "authors", "publicationDate", "doiOrStableUri", "publisherOrJournal", "language", "jurisdiction", "evidenceType", "evidenceLevel", "topicCodes", "population", "study", "claimBoundary", "effectAndUncertainty", "conditions", "limitations", "sourceSpans", "review", "contentHash"],
  "properties": {
    "schemaVersion": { "const": "evidence-card-v1" },
    "evidenceId": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,127}$" },
    "version": { "type": "integer", "minimum": 1 },
    "status": { "enum": ["draft", "reviewed", "active", "retired"] },
    "title": { "type": "string", "minLength": 1, "maxLength": 1000 },
    "authors": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1, "maxLength": 300 } },
    "publicationDate": { "type": "string", "pattern": "^[0-9]{4}(-[0-9]{2}-[0-9]{2})?$" },
    "doiOrStableUri": { "type": "string", "format": "uri", "maxLength": 2000 },
    "publisherOrJournal": { "type": "string", "minLength": 1, "maxLength": 500 },
    "language": { "type": "string", "minLength": 2, "maxLength": 20 },
    "jurisdiction": { "type": "string", "minLength": 2, "maxLength": 64 },
    "evidenceType": { "enum": ["guideline", "meta_analysis", "systematic_review", "peer_reviewed_study"] },
    "evidenceLevel": { "enum": ["high", "moderate", "limited"] },
    "topicCodes": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,63}$" } },
    "population": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ageRange", "setting", "inclusion", "exclusions"],
      "properties": {
        "ageRange": { "type": "string", "minLength": 1, "maxLength": 500 },
        "setting": { "type": "string", "minLength": 1, "maxLength": 1000 },
        "inclusion": { "type": "string", "minLength": 1, "maxLength": 2000 },
        "exclusions": { "type": "string", "minLength": 1, "maxLength": 2000 }
      }
    },
    "study": {
      "type": "object",
      "additionalProperties": false,
      "required": ["design", "sampleSize", "comparator"],
      "properties": {
        "design": { "type": "string", "minLength": 1, "maxLength": 1000 },
        "sampleSize": { "anyOf": [{ "type": "integer", "minimum": 1 }, { "const": "unknown" }] },
        "comparator": { "type": "string", "minLength": 1, "maxLength": 1000 }
      }
    },
    "claimBoundary": { "type": "string", "minLength": 1, "maxLength": 4000 },
    "effectAndUncertainty": { "type": "string", "minLength": 1, "maxLength": 4000 },
    "conditions": { "type": "string", "minLength": 1, "maxLength": 4000 },
    "limitations": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1, "maxLength": 2000 } },
    "sourceSpans": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["locator", "supportingText"],
        "properties": {
          "locator": { "type": "string", "minLength": 1, "maxLength": 500 },
          "supportingText": { "type": "string", "minLength": 1, "maxLength": 1500 }
        }
      }
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reviewedBy", "reviewedAt", "notes"],
      "properties": {
        "reviewedBy": { "type": "string", "minLength": 1, "maxLength": 128 },
        "reviewedAt": { "type": "string", "format": "date-time" },
        "notes": { "type": "string", "maxLength": 4000 }
      }
    },
    "contentHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
  }
}

