# 본인 PC 자체 호스팅(D-030)의 로컬 .env 예시. 실제 .env는 Git에서 제외된다.
# D-025/D-030: 휴대폰 브라우저가 1회 입력하는 서버 접근 토큰. 길고 무작위한 값으로 생성한다.
APP_ACCESS_TOKEN=
# 서버가 bind할 사설망 주소(예: Tailscale 100.x.x.x). 0.0.0.0에 bind하지 않는다.
APP_BIND_HOST=
# SQLite 데이터 파일 경로(백업 대상)
APP_DB_PATH=./data/emotion-diary.sqlite
# D-019: 유료 API(OpenAI API 등)는 사용하지 않는다. OPENAI_API_KEY 등 유료 API 키 변수를 추가하지 않는다.
# AI 기능은 사용자가 구독 중인 Codex/Claude 자원으로 가능한 경로가 B-06에서 확인된 경우에만 활성화하며,
# 그 경로에 필요한 설정 변수는 확인 뒤 여기와 docs/ARCHITECTURE.md에 함께 추가한다.
OWNER_KEY_HMAC_SECRET=
# D-025: 변경 API가 요구하는 custom header 값. 비밀값은 아니지만 배포마다 고정한다.
CSRF_REQUIRED_HEADER_VALUE=emotion-diary
