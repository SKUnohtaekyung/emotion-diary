# D-032: 배포는 Cloudflare Pages/Workers/D1. Workers 비밀값은 `wrangler secret put <NAME>`으로 넣고
# wrangler.toml이나 저장소에 값을 쓰지 않는다. 아래는 이름과 의미만 적은 예시다.
#
# [Workers secret]
# APP_ACCESS_TOKEN_HASH   휴대폰이 1회 입력하는 긴 무작위 접근 토큰의 해시(D-025)
# SESSION_HMAC_SECRET     세션 cookie·turn_token 서명용
# WORKER_SECRET           PC AI worker가 ai_jobs 경로에 보내는 Bearer secret
#
# [본인 PC의 AI worker .env] — 이 파일 형식으로 PC에만 둔다(Git 제외)
# D-019: 유료 API(OPENAI_API_KEY 등)를 쓰지 않는다. claude -p는 Claude Code 로그인 자격 증명을 사용하며
# worker가 그 값을 읽거나 복사하지 않는다.
API_BASE_URL=
WORKER_SECRET=
# D-031 모델. journal_turn은 Sonnet 5, analysis_verify/analysis_generate는 Opus 5
CLAUDE_MODEL_JOURNAL=claude-sonnet-5
CLAUDE_MODEL_ANALYSIS=claude-opus-5
# 프로젝트 hooks/MCP가 섞이지 않도록 claude -p를 실행할 전용 작업 디렉터리
CLAUDE_WORKDIR=
