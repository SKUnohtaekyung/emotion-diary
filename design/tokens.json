{
  "$schema": "https://example.invalid/schemas/design-tokens-v1.json",
  "version": "design-tokens-v1",
  "source": "references/source/*.jpg 의 7개 감정 색 계열을 접근성 기준으로 정규화. 정본 설명은 docs/DESIGN_SYSTEM.md",
  "color": {
    "neutral": {
      "bg": { "light": "#FFFFFF", "dark": "#121211" },
      "surface": { "light": "#FAFAF8", "dark": "#1B1B19" },
      "surface-raised": { "light": "#FFFFFF", "dark": "#232320" },
      "border": { "light": "#E6E4DE", "dark": "#33322E" },
      "border-strong": { "light": "#C9C7BF", "dark": "#4A4842" },
      "text": { "light": "#1F1F1D", "dark": "#F0EFEA" },
      "text-muted": { "light": "#5F5E5A", "dark": "#B5B3AA" },
      "text-subtle": { "light": "#767570", "dark": "#8F8E87" },
      "focus": { "light": "#2F6FB5", "dark": "#7FB3F0" }
    },
    "semantic": {
      "success": { "light": "#2E7D32", "dark": "#7FCB84" },
      "warning": { "light": "#9A5B00", "dark": "#F0B54A" },
      "danger": { "light": "#C62828", "dark": "#F28B82" },
      "info": { "light": "#2F6FB5", "dark": "#7FB3F0" }
    },
    "emotion": {
      "enjoyment": { "label": "즐거움", "source": "연두·초록, 춤추는 흰 공룡/고양이", "50": "#F1F8E6", "100": "#DCEFC2", "300": "#A9D67C", "500": "#5E9C2E", "700": "#3F7A1C", "900": "#1F4A0E" },
      "wish":      { "label": "바램",   "source": "가장 옅은 라일락(분홍기), 고양이", "50": "#F8EFFC", "100": "#EFDAF7", "300": "#D5A3E8", "500": "#A855CE", "700": "#7B3399", "900": "#48195C" },
      "sadness":   { "label": "슬픔",   "source": "하늘·청색, 물 위의 고양이",     "50": "#EAF4FB", "100": "#CFE6F7", "300": "#8FC2EA", "500": "#3F8FD6", "700": "#245F97", "900": "#143A5E" },
      "anger":     { "label": "분노",   "source": "주황·붉은색, 폭발/어두운 고양이", "50": "#FDEEE7", "100": "#FBD5C4", "300": "#F5A07E", "500": "#E8663C", "700": "#A63F1E", "900": "#64240F" },
      "joy":       { "label": "기쁨",   "source": "노랑, 날아가는 고양이",         "50": "#FFF9E0", "100": "#FDF0B3", "300": "#F8DE66", "500": "#E9BE1A", "700": "#B08A00", "900": "#5C4904" },
      "love":      { "label": "사랑",   "source": "분홍, 하트 고양이",             "50": "#FDEEF4", "100": "#FAD3E2", "300": "#F29CBE", "500": "#E1609B", "700": "#A33566", "900": "#641C3C" },
      "hate":      { "label": "미움",   "source": "가장 짙은 남색·보라, 흰 공룡",   "50": "#ECEEF8", "100": "#D2D6EE", "300": "#98A0D4", "500": "#4750A6", "700": "#2F3878", "900": "#1B2049" }
    },
    "emotion-usage": {
      "chip-fill": { "light": "100", "dark": "900" },
      "chip-border": { "light": "300", "dark": "700" },
      "chip-text": { "light": "900", "dark": "100" },
      "category-accent": { "light": "500", "dark": "300" },
      "chart-series": { "light": "500", "dark": "300" },
      "accent-override": { "joy": { "light": "700", "note": "노랑 500은 흰 배경에서 1.77:1로 3:1 미달이라 테두리·작은 아이콘·차트 선 강조는 700(#B08A00, 3.24:1)을 쓴다. chip fill/text 규칙과 큰 면의 500 사용은 동일 (D-034)" } },
      "soft-background": { "light": "50", "dark": "900@40%" }
    }
  },
  "typography": {
    "family": {
      "sans": "\"Pretendard Variable\", Pretendard, -apple-system, BlinkMacSystemFont, \"Apple SD Gothic Neo\", \"Noto Sans KR\", \"Segoe UI\", Roboto, sans-serif",
      "mono": "\"JetBrains Mono\", \"SF Mono\", Menlo, Consolas, monospace"
    },
    "scale": {
      "display": { "size": 28, "line": 36, "weight": 700 },
      "title": { "size": 22, "line": 30, "weight": 700 },
      "heading": { "size": 18, "line": 26, "weight": 600 },
      "body": { "size": 16, "line": 24, "weight": 400 },
      "body-strong": { "size": 16, "line": 24, "weight": 600 },
      "label": { "size": 14, "line": 20, "weight": 500 },
      "caption": { "size": 12, "line": 16, "weight": 400 }
    },
    "webfont": { "load": false, "note": "MVP는 웹폰트를 싣지 않고 시스템 한글 글꼴로 렌더링한다(D-034). 스택이 Pretendard를 먼저 찾으므로 나중에 @font-face만 추가하면 토큰 변경 없이 전환된다" },
    "rules": { "min-input-font-px": 16, "max-line-length-ch": 38, "word-break": "keep-all" }
  },
  "space": { "1": 4, "2": 8, "3": 12, "4": 16, "5": 20, "6": 24, "8": 32, "10": 40, "12": 48 },
  "radius": { "control": 8, "card": 12, "sheet": 16, "chip": 999 },
  "size": { "touch-target-min": 44, "content-max-width": 480, "bottom-nav-height": 56, "safe-area": "env(safe-area-inset-*)" },
  "border": { "hairline": 1, "emphasis": 2 },
  "elevation": { "policy": "flat; no drop shadows. 계층은 배경 단계(bg/surface/raised)와 hairline border로 표현" },
  "motion": {
    "duration": { "fast": 120, "base": 200, "slow": 320 },
    "easing": "cubic-bezier(0.2, 0, 0, 1)",
    "reduced-motion": "prefers-reduced-motion: reduce 이면 transform/opacity 전환만 남기고 캐릭터 애니메이션 제거"
  },
  "mode": { "mvp": "light-only", "note": "dark 토큰은 정의와 대비 검사를 유지하되 MVP 화면에는 적용하지 않는다(D-034). 적용 시 prefers-color-scheme만 따르고 앱 내 토글은 두지 않는다" },
  "z": { "base": 0, "sticky": 10, "bottom-nav": 20, "sheet": 30, "toast": 40 }
}
